# ---- Required ----
# Password for signing in to the app. Required when deployed; optional locally.
APP_PASSWORD=

# Anthropic — reads recipe photos and arranges meal plans
ANTHROPIC_API_KEY=sk-ant-...
# Optional override; defaults to claude-sonnet-5-5
ANTHROPIC_MODEL=claude-sonnet-5-5

# Kroger — from https://developer.kroger.com
KROGER_CLIENT_ID=pantry-pilot-bbcj78d9
KROGER_CLIENT_SECRET=
# Must exactly match a Redirect URI on your Kroger app. The app answers on
# /callback, /api/kroger/callback and /api/auth/kroger/callback.
#   local:  http://localhost:3001/callback
#   Vercel: https://<your-project>.vercel.app/api/kroger/callback
KROGER_REDIRECT_URI=http://localhost:3001/callback
# PICKUP or DELIVERY — how items are tagged when added to the cart
KROGER_MODALITY=PICKUP

# ---- Storage (set automatically on Vercel by the Neon and Blob integrations) ----
# Postgres connection string. Leave empty locally to use the built-in database in ./data
DATABASE_URL=
# Vercel Blob token for recipe photos. Leave empty locally to store photos in ./data/uploads
BLOB_READ_WRITE_TOKEN=

# Local-only: where the built-in database and photos live
DATA_DIR=./data
